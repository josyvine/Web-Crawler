{
  "manifest_version": 3,
  "name": "Monitoring Intelligence Extractor",
  "version": "1.0.0",
  "description": "Background DOM observing and dynamic URL telemetry crawler for the monitoring platform.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}